@model RaceDay.MVC.Models.EventViewModel
@{ ViewData["Title"] = "Event Details"; }

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h3 class="fw-bold mb-3">Event Configuration</h3>
            @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
            @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="EventId" />
                <div class="mb-3">
                    <label asp-for="EventName" class="form-label fw-semibold">Event Name</label>
                    <input asp-for="EventName" class="form-control" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label fw-semibold">Event Date</label>
                        <input asp-for="EventDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label fw-semibold">Location</label>
                        <input asp-for="Location" class="form-control" required />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label fw-semibold">Discipline</label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Road Running</option>
                            <option value="Walk">Walking</option>
                            <option value="Cycle">Cycling</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label fw-semibold">Primary Distance (km)</label>
                        <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="RouteInfo" class="form-label fw-semibold">Description & Route Info</label>
                    <textarea asp-for="RouteInfo" rows="3" class="form-control"></textarea>
                </div>
                <div class="mb-4">
                    <label asp-for="BannerFile" class="form-label fw-semibold">Event Banner Image (Uploads to Azure Blob)</label>
                    <input asp-for="BannerFile" type="file" accept="image/*" class="form-control" />
                </div>
                <button type="submit" class="btn btn-raceday px-4">Save Event</button>
                <a asp-action="Dashboard" class="btn btn-light ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>