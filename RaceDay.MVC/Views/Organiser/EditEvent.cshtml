@model RaceDay.MVC.Models.EventViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h3 class="fw-bold mb-1">Edit Event</h3>
            <p class="text-muted mb-4">Update the details or banner image for <strong>@Model.EventName</strong></p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="EditEvent" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="OrganiserId" />
                <input type="hidden" asp-for="BannerImageUrl" />

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label fw-semibold">Event Name</label>
                    <input asp-for="EventName" class="form-control" required />
                    <span asp-validation-for="EventName" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label fw-semibold">Event Date</label>
                        <input asp-for="EventDate" type="date" class="form-control" required />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label fw-semibold">Location</label>
                        <input asp-for="Location" class="form-control" required />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label fw-semibold">Discipline</label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Road Running</option>
                            <option value="Walk">Walking</option>
                            <option value="Cycle">Cycling</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label fw-semibold">Primary Distance (km)</label>
                        <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
                        <span asp-validation-for="Distance" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="RouteInfo" class="form-label fw-semibold">Description & Route Info</label>
                    <textarea asp-for="RouteInfo" rows="3" class="form-control"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Current Banner Image</label>
                        <img src="@Model.BannerImageUrl" alt="Current Banner" class="img-fluid rounded border" style="max-height: 180px; object-fit: cover;" />
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="BannerFile" class="form-label fw-semibold">Replace Banner Image (Optional)</label>
                    <input asp-for="BannerFile" type="file" accept="image/*" class="form-control" />
                    <small class="text-muted">Leave blank to keep the existing banner image.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-raceday px-4">Update Event</button>
                    <a asp-action="Dashboard" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>