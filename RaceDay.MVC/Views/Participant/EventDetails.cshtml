@model RaceDay.MVC.Models.EventViewModel
@{ ViewData["Title"] = Model.EventName; }

<div class="card overflow-hidden mb-4">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" class="w-100" style="max-height: 320px; object-fit: cover;" alt="@Model.EventName" />
    }
    <div class="card-body p-4">
        <h2 class="fw-bold">@Model.EventName</h2>
        <p class="text-muted fw-semibold">@Model.EventDate.ToString("dddd, dd MMMM yyyy") • @Model.Location</p>
        <p class="mt-3">@Model.RouteInfo</p>

        <hr class="my-4" />
        <h4 class="fw-bold mb-3">Available Race Categories</h4>
        <div class="row">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-md-4 mb-3">
                    <div class="card border p-3 h-100">
                        <h5 class="fw-bold">@cat.CategoryName</h5>
                        <p class="mb-1 text-muted">@cat.Discipline • @cat.DistanceKm km</p>
                        <h5 class="text-success fw-bold my-2">R @cat.EntryFee.ToString("F2")</h5>
                        <form asp-action="Enrol" method="post" class="mt-auto">
                            <input type="hidden" name="eventId" value="@Model.EventId" />
                            <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                            <button type="submit" class="btn btn-raceday w-100">Enter Category</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>